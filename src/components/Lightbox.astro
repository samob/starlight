---
import { Image } from 'astro:assets';

interface Props {
  id: string;
  src: ImageMetadata;
  alt: string;
  width?: number;
  height?: number;
  format?: string;
}

const { id, src, alt, width, height, format } = Astro.props;
---

<starlight-lightbox>
  <Image
    src={src}
    alt={alt}
    loading="lazy"
    decoding="async"
    fetchpriority="auto"
    class="lightbox-thumbnail"
    {width}
    {height}
    {format}
  />

  <dialog id={id} class="lightbox">
    <form method="dialog">
      <button class="close" aria-label="Close">&times;</button>
    </form>
    <div class="content">
      <Image
        src={src}
        alt={alt}
        loading="lazy"
        decoding="async"
        fetchpriority="auto"
        {width}
        {height}
        {format}
      />
    </div>
  </dialog>
</starlight-lightbox>

<style>
  .lightbox-thumbnail {
    display: block;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    cursor: pointer;
  }

  dialog.lightbox {
    border: none;
    background: transparent;
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    padding: 0;
    margin: 0;
  }

  dialog.lightbox::backdrop {
    background: rgba(0, 0, 0, 0.9);
  }

  dialog.lightbox .content {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100vh;
  }

  dialog.lightbox .content img {
    max-width: 98%;
    max-height: 92vh;
    object-fit: contain;
  }

  dialog.lightbox .close {
    position: fixed;
    top: 20px;
    right: 30px;
    font-size: 50px;
    color: white;
    background: rgba(0, 0, 0, 0.7);
    border: none;
    border-radius: 50%;
    width: 60px;
    height: 60px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s;
    z-index: 1;
  }

  dialog.lightbox .close:hover {
    background: rgba(0, 0, 0, 0.9);
  }
</style>

<script>
  class StarlightLightbox extends HTMLElement {
    constructor() {
      super();
      const dialog = this.querySelector<HTMLDialogElement>('dialog.lightbox');
      const thumbnail = this.querySelector('.lightbox-thumbnail');
      if (dialog && thumbnail) {
        thumbnail.addEventListener('click', () => dialog.showModal());
        const image = dialog.querySelector('.content img');
        if (image) {
          image.addEventListener('click', () => dialog.close());
        }
      }
    }
  }
  customElements.define('starlight-lightbox', StarlightLightbox);
</script>
